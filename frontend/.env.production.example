# ---------------------------------------------------------------------------
# Frontend production environment (Vite reads VITE_* at BUILD time).
#
# Set this value in the Vercel dashboard (Project -> Settings -> Environment
# Variables). This file is only a reference of what must be defined.
#
# IMPORTANT: the value MUST end with "/api" — the API client appends
# "/v1/..." to it (final calls hit https://<backend>/api/v1/...).
# ---------------------------------------------------------------------------
VITE_API_URL=https://your-backend-name.up.railway.app/api
